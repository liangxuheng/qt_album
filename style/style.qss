MainWindow {
    background-color: rgb(46,47,48);
}

QMenuBar{
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
}

QMenu {
    color:rgb(231,231,231);
    background-color:rgb(55,55,55);
}

QMenuBar::item:selected {
    background-color:rgb(80,80,80);
}

QMenu::item:selected {
    background-color:rgb(39,96,154);
}

Qwizard {
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
}

Qwizard QLabel#tips {
    color:red;
}

QTreeView {
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
    border: 0px;
}

QTreeView::item:hover {
    background: rgb(38, 95, 153);
}

QTreeView::item:selected {
    background: rgb(38, 95, 153);
}

/*设置选中条目字体变粗*/
#TreeProActiveItem {
    font-weight:bold;
}


QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings
{image: url(:/res/down.png);}


QTreeView::branch:closed:has-children:!has-siblings,
QTreeView::branch:closed:has-children:has-siblings
{image: url(:/res/right.png);}

PicShow {
    border-color : #9f9f9f;
    border-style: solid;
    border-width: 1px 1px 1px 1px;
    padding: 10px;
    background: rgb(64,66,68);
}

#nextBtn, #previousBtn{
    border: 0px;
}


SlideShowDialog {
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
}

#prelistView {
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
    border: 0px;
}

#prelistView::item:hover {
    background: rgb(38, 95, 153);
}

#prelistView::item:selected {
    background: rgb(38, 95, 153);
}

#slidePrewid {
    margin-left:10px;
}

#sliednextwid{
    margin-right:10px;
}

#prelistView::item:selected:active{
    border: 2px solid #FFFFFF;
}

#prelistView::item:selected{
    border: 2px solid #FFFFFF;
}

#slidePreBtn, #sliedNextBtn, #playBtn, #closeBtn{
    border: 0px
}